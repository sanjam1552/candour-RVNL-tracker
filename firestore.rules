rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rvnl_tracker/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email.endsWith('@candour.co.in');
    }
    match /rvnl_briefings/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email.endsWith('@candour.co.in');
    }
  }
}

